# Keep the bytes used by source/configuration hashes identical across checkouts.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
# JUnit artifacts retain verbatim traceback whitespace for auditability.
/results/**/*.xml -whitespace
# Downloaded Windows evidence is hashed verbatim, including its CRLF bytes.
/results/windows_sensor_v13/** -text -whitespace
